{
  "name": "@kinex/pi",
  "version": "1.0.0",
  "description": "Kinex integration for pi",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "dependencies": {
    "@kinex/core": "1.0.0",
    "@kinex/setup": "1.0.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "keywords": [
    "pi-package"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.1.0 <1.2.0",
    "@earendil-works/pi-tui": ">=1.1.0 <1.2.0",
    "typebox": "^1.3.27"
  }
}
