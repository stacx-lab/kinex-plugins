{
  "name": "@kinex/opencode",
  "version": "1.0.0",
  "description": "Kinex integration for opencode",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.22.2",
    "opencode": "1.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "dependencies": {
    "@kinex/core": "1.0.0",
    "@opencode-ai/plugin": "1.19.0",
    "zod": "^4.4.3",
    "@opencode-ai/sdk": "1.19.0",
    "@kinex/setup": "1.0.0"
  },
  "main": "./dist/server.js"
}
