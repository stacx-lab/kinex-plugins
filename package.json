    "@types/node": "22.20.4",
    "opencode-ai": "1.19.0",
    "typescript": "5.9.3",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "typebox": "1.3.27",
    "@kinex/core": "file:vendor/kinex-core-1.0.0-765d2895c23318e7.tgz",
    "@kinex/setup": "file:vendor/kinex-setup-1.0.0-1435af1dffd04bd9.tgz"
  }
