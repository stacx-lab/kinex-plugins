{
  "name": "kinex-plugins",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "packages/mcp",
    "packages/pi"
  ],
  "scripts": {
    "build": "node script/build.mjs",
    "typecheck": "npm run build",
    "test": "node --test test/*.test.mjs packages/mcp/test/*.test.mjs packages/pi/test/*.test.mjs",
    "test:pi": "node --test packages/pi/test/*.test.mjs",
    "core:refresh": "node script/refresh-core.mjs",
    "core:check": "node script/core-snapshot.mjs",
    "pack": "node script/release.mjs",
    "test:mcp": "node --test packages/mcp/test/*.test.mjs",
    "generate": "node script/generate.mjs",
    "kinex:sync": "node script/sync.mjs",
    "benchmark": "node script/benchmark.mjs",
    "install-plugins": "node script/hosts.mjs install",
    "update": "node script/update.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.299",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@kinex/core": "file:vendor/kinex-core-1.1.0-8f5786fb5331028e.tgz",
    "@kinex/setup": "file:vendor/kinex-setup-1.1.0-8bd29754ef63b033.tgz",
    "@openai/codex": "0.162.1",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
